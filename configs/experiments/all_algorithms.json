      "device": "cuda:0",
      "headless": true,
      "validation": {
        "enabled": true,
        "seeds": [901, 902],
        "test_delays": [0, 2, 4, 6],
        "interval": 100,
        "start_iteration": 100,
        "num_envs": 256,
        "num_episodes": 256,
        "lock_file": "logs/rsl_rl/.locks/training_validation_gpu3.lock"
