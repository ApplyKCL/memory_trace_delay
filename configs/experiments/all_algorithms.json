{
  "version": 1,
  "notes": [
    "Run with: python scripts/run_experiments.py --config configs/experiments/all_algorithms.json",
    "Set method.enabled=false to omit a method.",
    "Set training.enabled=false to reuse checkpoint_glob without retraining.",
    "Set evaluation.enabled=false to train without evaluating.",
    "Add normal CLI or Hydra overrides to a stage's extra_args list.",
    "GPU workers dynamically pull independent method-by-seed jobs from one shared queue.",
    "Every configured model is retrained in a new timestamped run.",
    "Periodic checkpoints are validated during training on the reserved validation GPU.",
    "Final evaluation automatically consumes each run's validation-selected best_model.pt."
  ],
  "continue_on_error": false,
  "execution": {
    "training_gpus": [0, 1, 2],
    "validation_gpu": 3,
    "evaluation_gpus": [0, 1, 2, 3],
    "training_workers": 3,
    "evaluation_workers": 4
  },
  "common": {
    "training": {
      "enabled": true,
      "seeds": [42, 43, 44],
      "num_envs": 4096,
