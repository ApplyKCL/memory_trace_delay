{
  "version": 1,
  "notes": [
    "Run with: python scripts/run_experiments.py --config configs/experiments/all_algorithms.json",
    "Set method.enabled=false to omit a method.",
    "Set training.enabled=false to reuse checkpoint_glob without retraining.",
    "Set evaluation.enabled=false to train without evaluating.",
    "Add normal CLI or Hydra overrides to a stage's extra_args list.",
    "GPU workers dynamically pull independent method-by-seed jobs from one shared queue.",
    "Every configured model is retrained in a new timestamped run.",
    "Periodic checkpoints are validated during training on the reserved validation GPU.",
    "Final evaluation automatically consumes each run's validation-selected best_model.pt."
  ],
  "continue_on_error": false,
  "execution": {
    "training_gpus": [
      0
    ],
    "validation_gpu": 3,
    "evaluation_gpus": [
      0
    ],
    "training_workers": 1,
    "evaluation_workers": 1
  },
  "common": {
    "training": {
      "enabled": true,
      "seeds": [
        42
      ],
      "num_envs": 128,
      "max_iterations": 101,
      "device": "cuda:0",
      "headless": true,
      "validation": {
        "enabled": true,
        "seeds": [
          901
        ],
        "test_delays": [
          0,
          4
        ],
        "interval": 100,
        "start_iteration": 100,
        "num_envs": 64,
        "num_episodes": 64,
        "lock_file": "logs/rsl_rl/.locks/validation_smoke_gpu3.lock"
      },
      "extra_args": []
    },
    "evaluation": {
      "enabled": true,
      "training_seeds": [
        42
      ],
      "seeds": [
        123
      ],
      "test_delays": [
        0,
        4
      ],
      "num_envs": 64,
      "num_episodes": 64,
      "device": "cuda:0",
      "headless": true,
      "overwrite": true,
      "extra_args": []
    }
  },
  "methods": [
    {
      "key": "trace08",
      "name": "Trace-PPO with decay 0.8",
      "enabled": true,
      "task": "MemoryTrace-Trace-Velocity-Flat-Unitree-Go2-v0",
      "experiment_name": "memory_trace_delay_go2_flat_trace",
      "training": {
        "enabled": true,
        "seeds": [
          42
        ],
        "delay_min": 0,
        "delay_max": 4,
        "run_name": "trace08_validation_smoke_seed{training_seed}",
        "checkpoint_glob": "logs/rsl_rl/memory_trace_delay_go2_flat_trace/*_trace08_delay0to4_seed{training_seed}_full/model_*.pt",
        "extra_args": []
      },
      "evaluation": {
        "enabled": true,
        "training_seeds": [
          42
        ],
        "output_dir": "results/validation_smoke/trace",
        "result_filename": "trace08_train0to4_trainseed{training_seed}_test{test_delay}_evalseed{evaluation_seed}.json",
        "extra_args": []
      }
    }
  ],
  "analysis": {
    "enabled": false,
    "mlp_dir": "results/final_best/mlp",
    "stack_dir": "results/final_best/stack",
    "trace_dir": "results/final_best/trace",
    "output_csv": "results/final_best/combined_summary.csv",
    "figure_dir": "results/final_best/figures",
    "benchmark_dir": "results/final_best/benchmarks",
    "benchmark_backend": "torchscript",
    "benchmark_device": "cpu",
    "engineering_csv": "results/final_best/engineering_summary.csv",
    "extra_args": []
  }
}
